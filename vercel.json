{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!maintenance\\.html$|favicon\\.ico$).*)",
      "destination": "/maintenance.html",
      "permanent": false
    }
  ]
}