{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s/img/:id",
      "destination": "/api/share?img=:id"
    },
    {
      "source": "/s/:id",
      "destination": "/api/share?id=:id"
    }
  ]
}